SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Google (Gmail) sign-in — create OAuth 2.0 Web credentials at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
# http://localhost:8000/accounts/google/callback/ (plus your production URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: public callback URL when behind a proxy/HTTPS terminator.
GOOGLE_REDIRECT_URI=

# Keep the admin session separate from listener sessions.
ADMIN_SESSION_COOKIE_NAME=audiora_admin_sessionid

# Cloudinary (cloud media storage for uploads) — get these from
# https://console.cloudinary.com/console → Dashboard → API Keys
CLOUD_NAME=
API_KEY=
API_SECRET=
# Or the full URL string instead of the three variables above:
CLOUDINARY_URL=
